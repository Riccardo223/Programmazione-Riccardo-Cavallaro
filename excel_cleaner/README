def trova_nome(colonna_file, alias_colonne):
    # "colonna_file" = il nome di UNA colonna presa dal file Excel caricato (es. "Full Name")
    # "alias_colonne" = il dizionario originale con tutte le categorie e i loro alias

    colonna_file_pulita = colonna_file.lower().strip()
    # trasforma il nome della colonna in minuscolo e toglie spazi iniziali/finali,
    # così il confronto funziona anche se il file ha "FULL NAME" o " Full Name "
    # es. "Full Name" -> "full name"

    # --- PARTE 1: costruzione del dizionario inverso ---
    # Obiettivo: passare da "categoria -> lista di alias" a "singolo alias -> categoria"
    # così possiamo cercare direttamente la parola che ci interessa, invece di scorrere liste

    alias_a_canonico = {}
    # dizionario vuoto che riempiremo qui sotto

    for nome_canonico, lista_alias in alias_colonne.items():
        # scorre ogni coppia del dizionario originale
        # es. 1° giro: nome_canonico = "Nome Cognome", lista_alias = ["nome cognome", "full name", ...]
        # es. 2° giro: nome_canonico = "Azienda", lista_alias = ["azienda", "company", ...]

        for alias in lista_alias:
            # ciclo annidato: scorre ogni singola parola DENTRO la lista corrente
            # es. quando nome_canonico = "Nome Cognome": prima alias = "nome cognome", poi "full name", ecc.

            alias_a_canonico[alias] = nome_canonico
            # aggiunge una singola coppia al dizionario inverso
            # es. alias_a_canonico["full name"] = "Nome Cognome"
            # si ripete per OGNI alias di OGNI categoria, finché il dizionario inverso non è completo

    # A questo punto, alias_a_canonico contiene TUTTI gli alias come chiavi singole,
    # ognuno che punta al proprio nome canonico, es:
    # {"nome cognome": "Nome Cognome", "full name": "Nome Cognome", "azienda": "Azienda", ...}

    # --- PARTE 2: ricerca vera e propria ---
    # Ora che il dizionario inverso è pronto, controlliamo se la colonna del file
    # (già pulita in minuscolo) corrisponde a uno degli alias conosciuti

    if colonna_file_pulita in alias_a_canonico:
        # "in" su un dizionario controlla se il valore è una delle CHIAVI
        # es. "full name" è una chiave di alias_a_canonico? Sì -> entra qui dentro

        return alias_a_canonico[colonna_file_pulita]
        # restituisce il valore associato a quella chiave, cioè il nome canonico
        # es. alias_a_canonico["full name"] -> restituisce "Nome Cognome"

    else:
        # se "colonna_file_pulita" non è nessuna delle chiavi conosciute,
        # vuol dire che non abbiamo trovato nessuna corrispondenza esatta

        return None
        # per ora restituiamo semplicemente "niente trovato"
        # (più avanti, qui aggiungeremo il fuzzy matching come piano B,
        #  prima di arrenderci del tutto con questo None)